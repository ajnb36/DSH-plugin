{
  "name": "dsh-redo",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Web 会话回退插件：在你发送的消息下方增加“回退”按钮，回退到该条消息之前并把这条消息回填到输入框",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rewind",
    "undo"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT"
}
